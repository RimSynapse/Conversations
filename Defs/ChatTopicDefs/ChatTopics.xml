<?xml version="1.0" encoding="utf-8" ?>
<!--
  Conversation topics. isChitchat topics fire on light social interactions; isDeepTalk on DeepTalk.
  <contextKeys> pull live pawn data into the prompt when the topic is chosen (see
  ConversationContextResolver). Chit-chat is kept lean; deep talk maximizes the context budget.
  Every topic is individually toggleable in mod settings.
-->
<Defs>

  <!-- ===================== CHIT-CHAT ===================== -->

  <RimSynapse.Conversations.ChatTopicDef>
    <defName>RimSynapse_Topic_Weather</defName>
    <label>weather</label>
    <topicName>Weather</topicName>
    <isChitchat>true</isChitchat>
    <isDeepTalk>false</isDeepTalk>
    <prompts>
      <li>the local weather and temperature changes</li>
      <li>whether they prefer sunny, rainy, or snowy days</li>
      <li>how the current season is affecting their mood</li>
    </prompts>
  </RimSynapse.Conversations.ChatTopicDef>

  <RimSynapse.Conversations.ChatTopicDef>
    <defName>RimSynapse_Topic_DailyRoutine</defName>
    <label>daily routine</label>
    <topicName>Daily Routine</topicName>
    <isChitchat>true</isChitchat>
    <isDeepTalk>false</isDeepTalk>
    <prompts>
      <li>the jobs they worked on today and what they'd rather be doing</li>
      <li>how tired or rested they feel after the day</li>
      <li>the little habits that get them through a shift</li>
    </prompts>
  </RimSynapse.Conversations.ChatTopicDef>

  <RimSynapse.Conversations.ChatTopicDef>
    <defName>RimSynapse_Topic_Gossip</defName>
    <label>gossip</label>
    <topicName>Gossip</topicName>
    <isChitchat>true</isChitchat>
    <isDeepTalk>false</isDeepTalk>
    <prompts>
      <li>a bit of gossip about another colonist's quirks or habits</li>
      <li>a minor rumor or story going around the colony</li>
      <li>something odd they noticed someone doing lately</li>
    </prompts>
  </RimSynapse.Conversations.ChatTopicDef>

  <RimSynapse.Conversations.ChatTopicDef>
    <defName>RimSynapse_Topic_FoodAndMeals</defName>
    <label>food and meals</label>
    <topicName>Food and Meals</topicName>
    <isChitchat>true</isChitchat>
    <isDeepTalk>false</isDeepTalk>
    <contextKeys><li>food</li></contextKeys>
    <prompts>
      <li>what they last ate and whether it was any good</li>
      <li>a meal they're craving or sick of</li>
      <li>a gripe or compliment about the cooking</li>
    </prompts>
  </RimSynapse.Conversations.ChatTopicDef>

  <RimSynapse.Conversations.ChatTopicDef>
    <defName>RimSynapse_Topic_Quarters</defName>
    <label>their quarters</label>
    <topicName>Their Quarters</topicName>
    <isChitchat>true</isChitchat>
    <isDeepTalk>false</isDeepTalk>
    <contextKeys><li>ownedRoom</li></contextKeys>
    <prompts>
      <li>their sleeping quarters and how comfortable (or not) they are</li>
      <li>something they'd change about where they bunk</li>
      <li>whether they'd like a room to themselves</li>
    </prompts>
  </RimSynapse.Conversations.ChatTopicDef>

  <RimSynapse.Conversations.ChatTopicDef>
    <defName>RimSynapse_Topic_Apparel</defName>
    <label>what they're wearing</label>
    <topicName>Apparel</topicName>
    <isChitchat>true</isChitchat>
    <isDeepTalk>false</isDeepTalk>
    <contextKeys><li>apparel</li></contextKeys>
    <prompts>
      <li>the clothes they're wearing and how they're holding up</li>
      <li>a garment that's worn out, tattered, or needs replacing</li>
      <li>a piece of gear they're proud of or want</li>
    </prompts>
  </RimSynapse.Conversations.ChatTopicDef>

  <RimSynapse.Conversations.ChatTopicDef>
