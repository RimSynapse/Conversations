    <topicName>Chores and Complaints</topicName>
    <isChitchat>true</isChitchat>
    <isDeepTalk>false</isDeepTalk>
    <prompts>
      <li>a chore they're tired of doing (hauling, cleaning, cooking)</li>
      <li>work they feel should be someone else's job</li>
